{
  "name": "a11y-vanilla-workshop",
  "private": true,
  "description": "Accessible Reads workshop — vitest unit tests and Playwright + axe e2e",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint \"**/*.{html,js,mjs}\"",
    "lint:fix": "eslint \"**/*.{html,js,mjs}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@html-eslint/eslint-plugin": "^0.20.0",
    "@html-eslint/parser": "^0.20.0",
    "@playwright/test": "^1.49.0",
    "eslint": "^8.57.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.3.3",
    "vitest": "^5.0.2",
    "vitest-axe": "^0.1.0"
  }
}
